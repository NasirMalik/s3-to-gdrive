#!/opt/homebrew/bin/python3
"""
s3gdrive — Downloads TES config files from S3, uploads to Google Drive,
then analyzes changes and updates the TES PDT Confluence page.

Requirements:
  - AWS CLI installed and configured
  - gcloud CLI authenticated with Drive scope:
      gcloud auth application-default login \
        --scopes=openid,https://www.googleapis.com/auth/userinfo.email,\
https://www.googleapis.com/auth/cloud-platform,https://www.googleapis.com/auth/drive
  - pip install google-api-python-client google-auth google-auth-httplib2 pyyaml requests

Confluence update requires env vars:
  CONFLUENCE_EMAIL       — your Atlassian account email
  CONFLUENCE_API_TOKEN   — API token from https://id.atlassian.com/manage/api-tokens
"""

import datetime
import json
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

import google.auth
import requests
import yaml
from googleapiclient.discovery import build
from googleapiclient.http import MediaFileUpload

# ---------------------------------------------------------------------------
# S3 / Drive config
# ---------------------------------------------------------------------------

S3_BUCKETS = [
    "production-ap-customer-logistics-seamless-configs-tes",
    "production-eu-customer-logistics-seamless-configs-tes",
    "production-kr2-customer-logistics-seamless-configs-tes",
    "production-us-customer-logistics-seamless-configs-tes",
]

DRIVE_FOLDER_ID = "1XLm6DJH-4-jgtv77w6mQyV6EYy9SjNVd"

SCOPES = ["https://www.googleapis.com/auth/drive"]

# ---------------------------------------------------------------------------
# Confluence config
# ---------------------------------------------------------------------------

CONFLUENCE_BASE_URL = "https://deliveryhero.atlassian.net/wiki"
CONFLUENCE_PAGE_ID = "1730215943"
# Marker that separates the hand-maintained top section from the auto-generated bottom table.
BOTTOM_SECTION_MARKER = "<h2>Config Coverage per Country</h2>"

SNAPSHOT_FILE = Path.home() / ".s3gdrive_snapshot.json"

PLATFORM_DISPLAY = {
    "pandora": "Pandora / Foodora",
    "peya": "PeYa",
    "hungerstation": "HungerStation",
    "talabat": "Talabat",
    "efood": "Efood / Foody",
    "glovo": "Glovo",
    "woowa": "Woowa",
}

# ---------------------------------------------------------------------------
# Drive helpers
# ---------------------------------------------------------------------------


def get_drive_service():
    creds, _ = google.auth.default(scopes=SCOPES)
    return build("drive", "v3", credentials=creds)


def create_drive_folder(service, name, parent_id):
    meta = {
        "name": name,
        "mimeType": "application/vnd.google-apps.folder",
        "parents": [parent_id],
    }
    folder = service.files().create(
        body=meta, fields="id", supportsAllDrives=True
    ).execute()
    return folder["id"]


def sync_from_s3(bucket, tmpdir):
    s3_path = f"s3://{bucket}/"
    print(f"[s3] Syncing {s3_path} ...")
    subprocess.run(["aws", "s3", "sync", s3_path, tmpdir], check=True)
    files = [f for f in Path(tmpdir).rglob("*") if f.is_file()]
    print(f"[s3] Downloaded {len(files)} file(s)")
    return files


def upload_to_drive(service, files, tmpdir, folder_id):
    for filepath in files:
        name = str(filepath.relative_to(tmpdir))
        print(f"[drive] Uploading {name} ...", end=" ", flush=True)
        media = MediaFileUpload(str(filepath), resumable=True)
        service.files().create(
            body={"name": name, "parents": [folder_id]},
            media_body=media,
            fields="id",
            supportsAllDrives=True,
        ).execute()
        print("done")


# ---------------------------------------------------------------------------
# YAML config analysis
# ---------------------------------------------------------------------------


def analyze_config(data):
    """Extract key properties from a parsed YAML config dict."""
    pdt = data.get("pdt", [])
    display_formats = {}  # delivery_mode -> format string
    ranges = set()        # delivery options with range bounds configured
    has_capping = False
    rounding_strategy = None

    for section in pdt:
        if "display_format" in section:
            for fmt in section["display_format"]:
                f = fmt.get("format", "")
                mode = fmt.get("conditions", {}).get("delivery_mode", "ALL")
                display_formats[mode] = f
        elif "ranges" in section:
            for r in section["ranges"]:
                ranges.add(r.get("delivery_option", "STANDARD"))
        elif "capping" in section:
            if section["capping"]:
                has_capping = True
        elif "rounding" in section:
            for r in section["rounding"]:
                rounding_strategy = r.get("strategy")

    pickup_fmt = display_formats.get("PICKUP", display_formats.get("ALL"))
    delivery_fmt = display_formats.get("DELIVERY", display_formats.get("ALL"))

    return {
        "country_code": data.get("country_code", "?"),
        "platform": data.get("platform", "unknown"),
        "pickup_is_range": pickup_fmt == "DISPLAY_FORMAT_MINUTE_RANGE",
        "delivery_is_range": delivery_fmt == "DISPLAY_FORMAT_MINUTE_RANGE",
        "has_standard": "STANDARD" in ranges,
        "has_priority": "PRIORITY" in ranges,
        "has_saver": "SAVER" in ranges,
        "has_capping": has_capping,
        "rounding_strategy": rounding_strategy or "—",
    }


def parse_yaml_files(files):
    """Parse a list of YAML Path objects; return list of analyzed config dicts."""
    configs = []
    for f in files:
        try:
            with open(f) as fh:
                data = yaml.safe_load(fh)
            if data:
                configs.append(analyze_config(data))
        except Exception as e:
            print(f"[warn] Failed to parse {f}: {e}")
    return configs


# ---------------------------------------------------------------------------
# Change detection
# ---------------------------------------------------------------------------

TRACKED_FIELDS = [
    "platform", "pickup_is_range", "delivery_is_range",
    "has_standard", "has_priority", "has_saver", "has_capping", "rounding_strategy",
]


def load_snapshot():
    if SNAPSHOT_FILE.exists():
        try:
            return json.loads(SNAPSHOT_FILE.read_text())
        except Exception:
            pass
    return {}


def save_snapshot(configs):
    snapshot = {c["country_code"]: c for c in configs}
    SNAPSHOT_FILE.write_text(json.dumps(snapshot, indent=2))


def detect_changes(old_snapshot, new_configs):
    """Return a list of human-readable change strings."""
    new_by_cc = {c["country_code"]: c for c in new_configs}
    changes = []

    for cc in sorted(set(new_by_cc) - set(old_snapshot)):
        changes.append(f"  + {cc}: new country added (platform={new_by_cc[cc]['platform']})")

    for cc in sorted(set(old_snapshot) - set(new_by_cc)):
        changes.append(f"  - {cc}: country removed")

    for cc in sorted(set(old_snapshot) & set(new_by_cc)):
        old, new = old_snapshot[cc], new_by_cc[cc]
        for field in TRACKED_FIELDS:
            if old.get(field) != new.get(field):
                changes.append(f"  ~ {cc}.{field}: {old.get(field)!r} → {new.get(field)!r}")

    return changes


# ---------------------------------------------------------------------------
# Confluence HTML generation
# ---------------------------------------------------------------------------


def _ck(val):
    return "✓" if val else "✗"


def build_country_table(configs):
    """Build the auto-generated Config Coverage per Country HTML table."""
    timestamp = datetime.datetime.utcnow().strftime("%Y-%m-%d %H:%M UTC")

    header = (
        "<thead><tr>"
        "<th><p>country_id</p></th>"
        "<th><p>Platform</p></th>"
        "<th><p>Pickup = Range</p></th>"
        "<th><p>Delivery = Range</p></th>"
        "<th><p>OD Standard Range</p></th>"
        "<th><p>OD Priority Range</p></th>"
        "<th><p>OD Saver Range</p></th>"
        "<th><p>Capping</p></th>"
        "<th><p>Rounding Strategy</p></th>"
        "</tr></thead>"
    )

    rows = []
    for c in sorted(configs, key=lambda x: x["country_code"]):
        platform_label = PLATFORM_DISPLAY.get(c["platform"], c["platform"])
        rows.append(
            "<tr>"
            f"<td><p>{c['country_code']}</p></td>"
            f"<td><p>{platform_label}</p></td>"
            f"<td><p>{_ck(c['pickup_is_range'])}</p></td>"
            f"<td><p>{_ck(c['delivery_is_range'])}</p></td>"
            f"<td><p>{_ck(c['has_standard'])}</p></td>"
            f"<td><p>{_ck(c['has_priority'])}</p></td>"
            f"<td><p>{_ck(c['has_saver'])}</p></td>"
            f"<td><p>{_ck(c['has_capping'])}</p></td>"
            f"<td><p>{c['rounding_strategy']}</p></td>"
            "</tr>"
        )

    return (
        f"<p><em>Auto-generated from S3 YAML configs. Last synced: {timestamp}.</em></p>"
        f'<table data-width="1200">{header}<tbody>{"".join(rows)}</tbody></table>'
    )


# ---------------------------------------------------------------------------
# Confluence REST API
# ---------------------------------------------------------------------------


def _confluence_auth():
    email = os.environ.get("CONFLUENCE_EMAIL")
    token = os.environ.get("CONFLUENCE_API_TOKEN")
    if not email or not token:
        return None
    return (email, token)


def _fetch_page(auth):
    url = f"{CONFLUENCE_BASE_URL}/rest/api/content/{CONFLUENCE_PAGE_ID}"
    resp = requests.get(url, auth=auth, params={"expand": "body.storage,version,title"})
    resp.raise_for_status()
    return resp.json()


def _push_page(version, title, body, auth):
    url = f"{CONFLUENCE_BASE_URL}/rest/api/content/{CONFLUENCE_PAGE_ID}"
    payload = {
        "version": {"number": version + 1},
        "title": title,
        "type": "page",
        "body": {"storage": {"value": body, "representation": "storage"}},
    }
    resp = requests.put(url, json=payload, auth=auth)
    resp.raise_for_status()
    return resp.json()


# ---------------------------------------------------------------------------
# Confluence update orchestration
# ---------------------------------------------------------------------------


def run_confluence_update(all_configs):
    auth = _confluence_auth()
    if not auth:
        print(
            "\n[confluence] Skipping page update — set CONFLUENCE_EMAIL and "
            "CONFLUENCE_API_TOKEN environment variables to enable."
        )
        return

    # --- Change detection ---
    old_snapshot = load_snapshot()
    changes = detect_changes(old_snapshot, all_configs)
    if changes:
        print(f"\n[confluence] {len(changes)} config change(s) since last sync:")
        for ch in changes:
            print(ch)
    else:
        print("\n[confluence] No config changes detected since last sync.")

    # --- Fetch current page ---
    print("[confluence] Fetching current page ...")
    try:
        page = _fetch_page(auth)
    except requests.HTTPError as e:
        print(f"[confluence] Error fetching page ({e.response.status_code}): {e.response.text[:200]}")
        return

    version = page["version"]["number"]
    title = page["title"]
    current_body = page["body"]["storage"]["value"]

    # --- Splice in new bottom table, preserve everything above ---
    if BOTTOM_SECTION_MARKER in current_body:
        top_portion = current_body[: current_body.index(BOTTOM_SECTION_MARKER)]
    else:
        top_portion = current_body  # no existing bottom section; append

    new_body = top_portion + BOTTOM_SECTION_MARKER + build_country_table(all_configs)

    if new_body == current_body:
        print("[confluence] Page content is already up to date, skipping update.")
        save_snapshot(all_configs)
        return

    # --- Push update ---
    print(f"[confluence] Updating page (version {version} → {version + 1}) ...")
    try:
        _push_page(version, title, new_body, auth)
        print(f"[confluence] Done. Page: {CONFLUENCE_BASE_URL}/pages/{CONFLUENCE_PAGE_ID}")
    except requests.HTTPError as e:
        print(f"[confluence] Error updating page ({e.response.status_code}): {e.response.text[:400]}")
        return

    save_snapshot(all_configs)


# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------


def main():
    if shutil.which("aws") is None:
        print("[error] AWS CLI not found. Install from https://aws.amazon.com/cli/")
        sys.exit(1)

    print("[auth] Loading credentials via gcloud application default ...")
    service = get_drive_service()

    all_configs = []  # accumulated across all buckets for Confluence update

    for bucket in S3_BUCKETS:
        print(f"\n=== {bucket} ===")
        with tempfile.TemporaryDirectory(prefix="s3gdrive_") as tmpdir:
            files = sync_from_s3(bucket, tmpdir)
            if not files:
                print("[info] No files found, skipping.")
                continue

            # Parse default.yml files while tmpdir is still alive
            default_yamls = [f for f in files if f.name == "default.yml"]
            all_configs.extend(parse_yaml_files(default_yamls))

            folder_id = create_drive_folder(service, bucket, DRIVE_FOLDER_ID)
            upload_to_drive(service, files, tmpdir, folder_id)
            print(f"[done] {len(files)} file(s) uploaded.")

    print("\n[done] All buckets processed.")

    if all_configs:
        run_confluence_update(all_configs)
    else:
        print("[confluence] No YAML configs found, skipping Confluence update.")


if __name__ == "__main__":
    main()
